# SkillBridge AI - Environment Configuration Example

# Flask Secret Key for sessions and CSRF
SECRET_KEY=skillbridge-super-secret-dev-key-nexora-2026

# Flask Environment (development, testing, production)
FLASK_ENV=development

# Database URI (defaults to SQLite local file)
DATABASE_URL=sqlite:///instance/skillbridge.db

# Optional LLM API keys for conversational mock interview coaching
# (Application works fully with built-in deterministic evaluation when keys are omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Server Port
PORT=5000
